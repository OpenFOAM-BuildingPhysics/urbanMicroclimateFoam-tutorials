FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

boundary
{
    inlet
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  inlet;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    outlet
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  outlet;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    top
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  top;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    ground
    {
        type            mappedWall;
        neighbourRegion air;
        neighbourPatch  ground;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    air_to_street
    {
        type            mappedInternal;
        neighbourRegion air;
        neighbourPatch  air_to_street;
        offsetMode      normal;
        distance        0;
    }
    air_to_windward
    {
        type            mappedInternal;
        neighbourRegion air;
        neighbourPatch  air_to_windward;
        offsetMode      normal;
        distance        0;
    }
    air_to_leeward
    {
        type            mappedInternal;
        neighbourRegion air;
        neighbourPatch  air_to_leeward;
        offsetMode      normal;
        distance        0;
    }
    side1
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  side1;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    side2
    {
        type            mapped;
        neighbourRegion air;
        neighbourPatch  side2;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    buildings
    {
        type            mappedWall;
        neighbourRegion air;
        neighbourPatch  buildings;
        offsetMode      uniform;
        offset          (0 0 0);
    }
    air_to_vegetation
    {
        type            mappedInternal;
        neighbourRegion air;
        offsetMode      normal;
        distance        0;
    }
}

